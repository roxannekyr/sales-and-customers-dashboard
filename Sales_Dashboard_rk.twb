        <calculation class='tableau' formula='IF COUNTD([Calculation_0832667998724106]) &gt; WINDOW_AVG(COUNTD([Calculation_0832667998724106]))&#13;&#10;THEN &apos;Above&apos;&#13;&#10;ELSE &apos;Below&apos;&#13;&#10;END&#13;&#10;&#13;&#10;//Function chcking if number of orders of current year &#13;&#10;//are above the average or not'>
