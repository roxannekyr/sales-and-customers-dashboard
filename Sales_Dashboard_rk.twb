            <run fontcolor='#8b4513' fontname='Tableau Bold' fontsize='12'><![CDATA[<[federated.02gtvv01ky5os819cikn412mkq9s].[sum:Calculation_0832668061823013:qk]> ]]></run>
            <run fontcolor='#ffd299' fontname='Tableau Bold' fontsize='12'>Æ </run>
            <run bold='true' fontcolor='#ffd299' fontname='Tableau Bold' fontsize='12'>vs. PY</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales DataSource' name='federated.02gtvv01ky5os819cikn412mkq9s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select year' datatype='integer' default-format='n0;-0' name='[Order Date (Years) Parameter]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02gtvv01ky5os819cikn412mkq9s'>
            <column caption='PY Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[CY Sales (copy)_1280443781074945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Order Date (Years) Parameter]-1 THEN [Sales]&#13;&#10;END&#13;&#10;&#13;&#10;//Calculating Previous Year Sales&#13;&#10;//Setting pre-last year of our values as current year check.&#13;&#10;//When condition is not met, function returns NULL.&#13;&#10;&#13;&#10;//if YEAR([Order Date])= 2022 THEN [Sales] END&#13;&#10;&#13;&#10;//After having created parameter Select year we adjust it' />
            </column>
            <column aggregation='CountD' caption='PY Customers' datatype='string' default-format='n#,##0,.0K;-#,##0,.0K' default-role='measure' default-type='quantitative' name='[Calculation_0832667980443652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Order Date (Years) Parameter]-1 THEN [Customer ID] &#13;&#10;END&#13;&#10;&#13;&#10;//Function checking if customer ordered in the previous year' />
            </column>
            <column aggregation='CountD' caption='PY Orders' datatype='string' default-format='c#,##0,.0K;(#,##0,.0K)' default-role='measure' default-type='quantitative' name='[Calculation_0832667980574725]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Order Date (Years) Parameter]-1 THEN [Order ID]&#13;&#10;END&#13;&#10;&#13;&#10;//Function checking if order was made in the previous year' />
            </column>
            <column caption='Min/Max Orders' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_0832667981959175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([Calculation_0832667998724106]) = WINDOW_MAX(COUNTD([Calculation_0832667998724106]))&#13;&#10;THEN COUNTD([Calculation_0832667998724106])&#13;&#10;ELSEIF COUNTD([Calculation_0832667998724106]) = WINDOW_MIN(COUNTD([Calculation_0832667998724106]))&#13;&#10;THEN COUNTD([Calculation_0832667998724106])&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;//Counting the unique orders for each mark on the view&#13;&#10;//then looking across the entire &quot;window&quot; timeline (etc month)&#13;&#10;//to find the absolute highest and lowest orders per customer.&#13;&#10;//If the current month matches that max or min number,&#13;&#10;// it returns the number. Otherwise, it returns nothing'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='CountD' caption='CY Customers' datatype='string' default-format='n#,##0,.0K;-#,##0,.0K' default-role='measure' default-type='quantitative' name='[Calculation_0832667998461961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Order Date (Years) Parameter] THEN [Customer ID] &#13;&#10;END&#13;&#10;&#13;&#10;//Function checking if customer ordered in the current year' />
            </column>
            <column aggregation='CountD' caption='CY Orders' datatype='string' default-format='n#,##0,.0K;-#,##0,.0K' default-role='measure' default-type='quantitative' name='[Calculation_0832667998724106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Order Date (Years) Parameter] THEN [Order ID] &#13;&#10;END&#13;&#10;&#13;&#10;//Function checking if order was made in the current year' />
            </column>
            <column caption='% Diff Customers' datatype='real' default-format='p0.0%' name='[Calculation_0832668025171982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Calculation_0832667998461961]) - COUNTD([Calculation_0832667980443652])) / COUNTD([Calculation_0832667980443652])' />
            </column>
            <column caption='# CY Customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0832668056748063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_0832667998461961])' />
            </column>
            <column caption='# PY Customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0832668056948768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_0832667980443652])' />
            </column>
            <column caption='# CY Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0832668060880929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_0832667998724106])' />
            </column>
            <column caption='# PY Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0832668060954658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_0832667980574725])' />
            </column>
            <column caption='% Diff Orders' datatype='real' default-format='p0.0%' name='[Calculation_0832668061532195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0832668060880929] - [Calculation_0832668060954658]) / [Calculation_0832668060954658]' />
            </column>
            <column caption='{[% Diff Orders]}' datatype='real' name='[Calculation_0832668061823013]' role='measure' type='quantitative' user:unnamed='Customer Orders'>
              <calculation class='tableau' formula='{[Calculation_0832668061532195]}' />
            </column>
            <column caption='{[# CY Orders]}' datatype='integer' name='[Calculation_0832668063154215]' role='measure' type='quantitative' user:unnamed='Customer Orders'>
              <calculation class='tableau' formula='{[Calculation_0832668060880929]}' />
            </column>
            <column caption='CY Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1280443779207168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Order Date (Years) Parameter] THEN [Sales] &#13;&#10;END&#13;&#10;&#13;&#10;//Calculating Current Year Sales&#13;&#10;//Setting last year of our values as current year check.&#13;&#10;//When condition is not met, function returns NULL.&#13;&#10;&#13;&#10;//if YEAR([Order Date])= 2023 THEN [Sales] END&#13;&#10;&#13;&#10;//After having created the parameter we adjust it.' />
            </column>
            <column caption='% Diff Sales' datatype='real' default-format='p0.0%' name='[Calculation_1280443784290307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1280443779207168]) - SUM([CY Sales (copy)_1280443781074945])) / SUM([CY Sales (copy)_1280443781074945])&#13;&#10;&#13;&#10;//Function calculates current year sales minus&#13;&#10;//last year sales and it divides it with previous year&#13;&#10;//sales,so as result that we have the difference in %&#13;&#10;&#13;&#10;//After creating the function we need also to adjust its&#13;&#10;//format accordingly in percentage by going to&#13;&#10;//default properties-&gt;Number format-&gt;percentage and &#13;&#10;//adjusting the decimal places (as we want) for example 1' />
            </column>
            <column aggregation='Sum' caption='Current Year' datatype='integer' default-format='n0;-0' name='[Calculation_1280443804581895]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Order Date (Years) Parameter]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' default-format='n0;-0' name='[Calculation_1280443804680200]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Order Date (Years) Parameter]-1' />
            </column>
