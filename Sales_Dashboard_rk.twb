    <worksheet name='KPI Sales'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#8f1e00' fontname='Tableau Book' fontsize='14'>Total Sales</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff7f50' fontname='Tableau Bold' fontsize='22'><![CDATA[<[federated.02gtvv01ky5os819cikn412mkq9s].[sum:Calculation_1280443800068101:qk]>]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#8b4513' fontname='Tableau Semibold' fontsize='12'><![CDATA[<[federated.02gtvv01ky5os819cikn412mkq9s].[sum:Calculation_1280443800522758:qk]>]]></run>
            <run fontcolor='#ffd299' fontname='Tableau Semibold' fontsize='12'>Æ </run>
            <run bold='true' fontcolor='#ffd299' fontname='Tableau Book' fontsize='12'>vs. PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales DataSource' name='federated.02gtvv01ky5os819cikn412mkq9s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select year' datatype='integer' default-format='n0;-0' name='[Order Date (Years) Parameter]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02gtvv01ky5os819cikn412mkq9s'>
            <column caption='PY Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[CY Sales (copy)_1280443781074945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Order Date (Years) Parameter]-1 THEN [Sales]&#13;&#10;END&#13;&#10;&#13;&#10;//Calculating Previous Year Sales&#13;&#10;//Setting pre-last year of our values as current year check.&#13;&#10;//When condition is not met, function returns NULL.&#13;&#10;&#13;&#10;//if YEAR([Order Date])= 2022 THEN [Sales] END&#13;&#10;&#13;&#10;//After having created parameter Select year we adjust it' />
            </column>
            <column caption='CY Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1280443779207168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Order Date (Years) Parameter] THEN [Sales] &#13;&#10;END&#13;&#10;&#13;&#10;//Calculating Current Year Sales&#13;&#10;//Setting last year of our values as current year check.&#13;&#10;//When condition is not met, function returns NULL.&#13;&#10;&#13;&#10;//if YEAR([Order Date])= 2023 THEN [Sales] END&#13;&#10;&#13;&#10;//After having created the parameter we adjust it.' />
            </column>
            <column caption='% Diff Sales' datatype='real' default-format='p0.0%' name='[Calculation_1280443784290307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1280443779207168]) - SUM([CY Sales (copy)_1280443781074945])) / SUM([CY Sales (copy)_1280443781074945])&#13;&#10;&#13;&#10;//Function calculates current year sales minus&#13;&#10;//last year sales and it divides it with previous year&#13;&#10;//sales,so as result that we have the difference in %&#13;&#10;&#13;&#10;//After creating the function we need also to adjust its&#13;&#10;//format accordingly in percentage by going to&#13;&#10;//default properties-&gt;Number format-&gt;percentage and &#13;&#10;//adjusting the decimal places (as we want) for example 1' />
            </column>
            <column caption='Min/Max Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1280443795509252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if sum([Calculation_1280443779207168]) = WINDOW_MAX(sum([Calculation_1280443779207168])) &#13;&#10;THEN sum([Calculation_1280443779207168])&#13;&#10;ELSEIF sum([Calculation_1280443779207168]) = WINDOW_MIN(sum([Calculation_1280443779207168])) &#13;&#10;THEN sum([Calculation_1280443779207168])&#13;&#10;END &#13;&#10;&#13;&#10;//Function checking if the total current sales are the max&#13;&#10;//of all values of total current sales, if so it shows the&#13;&#10;//total current sales. Also same check with checking for&#13;&#10;//min logic. This function will be used in the sparkline&#13;&#10;//for highlighting the min &amp; max sales of CY year'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='{SUM([CY Sales])}' datatype='real' name='[Calculation_1280443800068101]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
              <calculation class='tableau' formula='{SUM([Calculation_1280443779207168])}' />
            </column>
            <column caption='{[% Diff Sales]}' datatype='real' name='[Calculation_1280443800522758]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
              <calculation class='tableau' formula='{[Calculation_1280443784290307]}' />
            </column>
            <column aggregation='Sum' caption='Current Year' datatype='integer' default-format='n0;-0' name='[Calculation_1280443804581895]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Order Date (Years) Parameter]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' default-format='n0;-0' name='[Calculation_1280443804680200]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Order Date (Years) Parameter]-1' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
