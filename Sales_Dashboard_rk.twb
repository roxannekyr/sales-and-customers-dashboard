              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Order Date (Years) Parameter]-1 THEN [Customer ID] &#13;&#10;END&#13;&#10;&#13;&#10;//Function checking if customer ordered in the previous year' />
            </column>
            <column aggregation='CountD' caption='CY Customers' datatype='string' default-format='n#,##0,.0K;-#,##0,.0K' default-role='measure' default-type='quantitative' name='[Calculation_0832667998461961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if YEAR([Order Date])= [Parameters].[Order Date (Years) Parameter] THEN [Customer ID] &#13;&#10;END&#13;&#10;&#13;&#10;//Function checking if customer ordered in the current year' />
