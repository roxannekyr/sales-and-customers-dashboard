              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Order Date (Years) Parameter]-1 THEN [Sales]&#13;&#10;END&#13;&#10;&#13;&#10;//Calculating Previous Year Sales&#13;&#10;//Setting pre-last year of our values as current year check.&#13;&#10;//When condition is not met, function returns NULL.&#13;&#10;&#13;&#10;//if YEAR([Order Date])= 2022 THEN [Sales] END&#13;&#10;&#13;&#10;//After having created parameter Select year we adjust it' />
