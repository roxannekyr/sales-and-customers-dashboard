    <worksheet name='KPI profit'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#8f1e00' fontname='Tableau Book' fontsize='14'>Total Profit</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff7f50' fontname='Tableau Bold' fontsize='22'><![CDATA[<[federated.02gtvv01ky5os819cikn412mkq9s].[sum:Calculation_0946742042742799:qk]>]]></run>
            <run>Æ&#10;</run>
